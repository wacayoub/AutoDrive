<resources>
    <style name="RadioTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorAccent">@color/radio_accent</item>
        <item name="android:windowBackground">@color/radio_window</item>
        <item name="android:statusBarColor">@color/radio_window</item>
        <item name="android:navigationBarColor">@color/radio_window</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
    <style name="RadioCompactAlert" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">@color/radio_accent</item>
        <item name="android:listPreferredItemHeightSmall">36dp</item>
    </style>
</resources>

<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape>
                    <corners android:radius="11dp" />
                    <solid android:color="#20384D" />
                    <stroke android:width="1dp" android:color="#385970" />
                </shape>
            </item>
            <item android:width="24dp" android:height="2dp" android:bottom="3dp"
                android:gravity="bottom|center_horizontal">
                <shape>
                    <corners android:radius="1dp" />
                    <solid android:color="#77C9FF" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape>
            <corners android:radius="11dp" />
            <solid android:color="#1A2430" />
        </shape>
    </item>
</selector>

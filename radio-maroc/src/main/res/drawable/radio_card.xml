<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape>
            <corners android:radius="12dp" />
            <gradient android:angle="270" android:startColor="#244057" android:endColor="#1B2E40" />
            <stroke android:width="1dp" android:color="#568CB1" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="12dp" />
            <solid android:color="#161F2A" />
            <stroke android:width="1dp" android:color="#273746" />
        </shape>
    </item>
</selector>

<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape>
            <corners android:radius="999dp" />
            <solid android:color="@color/radio_selected" />
            <stroke android:width="1dp" android:color="@color/radio_selected_border" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="999dp" />
            <solid android:color="@color/radio_control" />
            <stroke android:width="1dp" android:color="@color/radio_control_border" />
        </shape>
    </item>
</selector>

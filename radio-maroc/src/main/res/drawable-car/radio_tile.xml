<!-- Incarlink: home-screen app tile, a dark face for the logo over a lighter band for the name. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <corners android:radius="18dp" />
            <gradient android:angle="270" android:startColor="#FF2A2C2F" android:endColor="#FF1F2023" />
            <stroke android:width="1dp" android:color="#FF3A3D41" />
        </shape>
    </item>
    <item android:gravity="bottom" android:height="36dp" android:left="1dp" android:right="1dp" android:bottom="1dp">
        <shape>
            <corners android:bottomLeftRadius="17dp" android:bottomRightRadius="17dp" />
            <gradient android:angle="270" android:startColor="#FF4A4C51" android:endColor="#FF3A3C40" />
        </shape>
    </item>
</layer-list>
